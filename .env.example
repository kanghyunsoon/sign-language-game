HANDPRACTICE_AI_HOST=0.0.0.0
HANDPRACTICE_AI_PORT=8765
HANDPRACTICE_AI_MODEL=baseline
# Decision-margin gate (top1 - top2). 0.25 = balanced, 0.3~0.4 = stricter
# practice mode, 0 = disabled. See game-ai-dev-server/README.md.
HANDPRACTICE_AI_MIN_MARGIN=0.25
# Landmark EMA applied before feature extraction. Weight of the NEW frame, so a
# smaller value smooths harder and lags more; 1.0 disables it.
# OFF by default (T-155): 0.3 measured well against synthetic jitter (T-154) but
# made real use worse. Do not enable without measuring on real frames.
HANDPRACTICE_AI_LANDMARK_SMOOTHING=1.0
# Prediction diagnostics (T-156). Leave the path empty to disable entirely.
# blocked = only frames the browser cannot confirm (gate fired or top-1 < 0.5).
# all     = every frame; use only for short, deliberate captures.
# Writes landmark coordinates and probabilities only - never video or frames.
# Analyse with: python scripts/analyze_diagnostics.py <path>
HANDPRACTICE_AI_DIAG_PATH=/app/diagnostics/predictions.jsonl
HANDPRACTICE_AI_DIAG_MODE=blocked
HANDPRACTICE_AI_DIAG_MAX_FRAMES=20000
# Host directory mounted at /app/diagnostics so the capture survives a restart.
AI_DIAG_DIR=/opt/sudal/ai/diagnostics
AI_MODEL_DIR=./models
HANDPRACTICE_WORD_HOST=0.0.0.0
HANDPRACTICE_WORD_PORT=8767
HANDPRACTICE_WORD_PATH=/word
HANDPRACTICE_WORD_CHECKPOINT=/app/models/word-19-v1/best_model.pt
HANDPRACTICE_WORD_CHECKPOINT_SHA256=898169cf56bfbe39a3ce3b13165a8d6a53c5b873033b278ad0ab1ca7f17a72f4
HANDPRACTICE_WORD_TORCH_THREADS=2
HANDPRACTICE_WORD_INFERENCE_WORKERS=1
