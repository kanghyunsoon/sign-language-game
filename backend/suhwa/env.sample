# Server
SERVER_PORT=8080

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=suhwa
DB_USERNAME=root
DB_PASSWORD=changeme

# JPA
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# JWT (HS256 서명 키 — 최소 32바이트 이상의 임의 문자열 필요, 아래는 더미 값이므로 반드시 교체할 것)
JWT_SECRET=CHANGE_ME_dummy_jwt_secret_value_please_replace_32plus_chars
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=1209600000

# Game Room
GAME_ROOM_WAITING_RETENTION_MINUTES=30
REALTIME_TICKET_TTL_SECONDS=3
GAME_ROOM_LEAVE_GRACE_SECONDS=7

# CORS (콤마로 구분된 허용 Origin 목록, 예: http://localhost:5173,https://example.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173
