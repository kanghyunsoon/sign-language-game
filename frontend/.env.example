# ?몄쬆/?좎? API 踰좎씠??(login쨌signup쨌users/me). 諛고룷 ?숈씪 ?ㅻ━吏꾩뿉?쒕뒗 "/api".
VITE_API_BASE_URL=http://localhost:8080/api
VITE_GAME_API_BASE_URL=http://localhost:8080/api
VITE_GAME_API_CREDENTIALS=include
# ?꾨줈?좏???DevBattleRoomGateway)??媛? 諛고룷 Swagger 寃쎈줈??"/api"(.env.production 李몄“).
VITE_GAME_ROOM_API_BASE_URL=/api/dev
VITE_GAME_WEBSOCKET_URL=ws://localhost:8091/ws/game
VITE_MATCH_COMMAND_DESTINATION=/app/game/message
VITE_MATCH_PLAYER_DESTINATION=/queue/game/player/{playerId}
VITE_MATCH_BROADCAST_DESTINATION=/topic/game/match/{matchId}
VITE_AI_WEBSOCKET_URL=ws://localhost:8765

# Development-only compatibility with the prototype game-api.
# Do not use this header as production authentication.
VITE_DEV_USER_ID=local-user
VITE_LINE_RACE_DEV_TOOLS=false

# Keep false until the backend publishes and authorizes POST /game/solo/sessions.
VITE_ENABLE_REMOTE_SOLO_GAME_API=false
